#!/bin/bash
# livewall — run HTML scenes as live desktop backgrounds (Hyprland / Omarchy).
#   livewall set <scene|file.html>   start a scene (name from scenes/ or a path)
#   livewall theme <omarchy-theme>   start the scene matching the theme, or turn off
#   livewall off                     stop and remember "off"
#   livewall list | status | restart
#   livewall run                     (used by the systemd service)
set -euo pipefail
REPO=$(dirname "$(dirname "$(readlink -f "$0")")")
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/livewall
STATE=$STATE_DIR/scene
PREV_FONT=$STATE_DIR/prev-font
mkdir -p "$STATE_DIR"

resolve() {
  if [[ -f $1 ]]; then realpath "$1"
  elif [[ -f $REPO/scenes/$1.html ]]; then echo "$REPO/scenes/$1.html"
  else return 1; fi
}

apply_theme_font() {
  local slug="$1" font_file="" target_font="" cur_font=""
  command -v omarchy >/dev/null 2>&1 || return 0
  if [[ -f "$HOME/.config/omarchy/themes/$slug/font.name" ]]; then
    font_file="$HOME/.config/omarchy/themes/$slug/font.name"
  elif [[ -f "$REPO/themes/$slug/font.name" ]]; then
    font_file="$REPO/themes/$slug/font.name"
  fi
  cur_font=$(omarchy font current 2>/dev/null || true)
  if [[ -n $font_file ]]; then
    target_font=$(head -n 1 "$font_file" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    if [[ -n $target_font && $cur_font != "$target_font" ]]; then
      [[ -f $PREV_FONT || -z $cur_font ]] || echo "$cur_font" > "$PREV_FONT"
      omarchy font set "$target_font" >/dev/null 2>&1 || true
    fi
  elif [[ -f $PREV_FONT ]]; then
    target_font=$(cat "$PREV_FONT" 2>/dev/null || true)
    rm -f "$PREV_FONT"
    if [[ -n $target_font && $cur_font != "$target_font" ]]; then
      omarchy font set "$target_font" >/dev/null 2>&1 || true
    fi
  fi
}

case ${1:-status} in
  run)
    scene=$(cat "$STATE" 2>/dev/null || true)
    [[ -z $scene || $scene == none || ! -f $scene ]] && exit 0
    exec /usr/bin/python3 "$REPO/host/livewall.py" "$scene" --fps "${LIVEWALL_FPS:-30}" ;;
  set)
    scene=$(resolve "${2:?usage: livewall set <scene|file.html>}") || { echo "livewall: no scene '$2' (try: livewall list)" >&2; exit 1; }
    echo "$scene" > "$STATE"
    systemctl --user restart livewall.service ;;
  theme)
    slug="${2:?usage: livewall theme <theme-slug>}"
    apply_theme_font "$slug"
    if scene=$(resolve "$slug" 2>/dev/null) && [[ $scene == "$REPO"/scenes/* ]]; then
      echo "$scene" > "$STATE"; systemctl --user restart livewall.service
    else
      echo none > "$STATE"; systemctl --user stop livewall.service
    fi ;;
  off)
    echo none > "$STATE"; systemctl --user stop livewall.service ;;
  restart)
    systemctl --user restart livewall.service ;;
  list)
    for f in "$REPO"/scenes/*.html; do n=$(basename "$f" .html); [[ $n == _* ]] || echo "$n"; done ;;
  status)
    echo "scene:   $(cat "$STATE" 2>/dev/null || echo none)"
    echo "service: $(systemctl --user is-active livewall.service || true)" ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
